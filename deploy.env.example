# Plantilla de variables de entorno para despliegue.
#
# Copiá estas variables en el panel de tu proveedor (Render o Railway), nunca en git.
# En Render: tu Web Service → Environment.
# En Railway: tu servicio API → Variables → Raw Editor.
#
# NUNCA subas el AccessToken ni el WebhookSecret reales al repositorio.

# --- JWT (obligatorio en producción, mínimo 32 caracteres) ---
# Generalo con: openssl rand -base64 48
TokenSettings__Secret=pega-aqui-un-string-aleatorio-de-32-caracteres-o-mas

# --- Base de datos (obligatorio) ---
# Render no ofrece MySQL gestionado, así que la base vive en otro proveedor.
# Debe verse así: server=X;port=3306;user=U;password=P;database=D
ConnectionStrings__DefaultConnection=server=X;port=3306;user=U;password=P;database=D

# --- MercadoPago ---
# Regeneralos en el panel de MercadoPago si alguna vez estuvieron en el repo.
MercadoPago__AccessToken=APP_USR-pega-aqui-tu-access-token
MercadoPago__PublicKey=APP_USR-pega-aqui-tu-public-key
MercadoPago__WebhookSecret=pega-aqui-tu-webhook-secret

# Origen del frontend (Vercel u otro), sin la barra final.
MercadoPago__FrontendBaseUrl=https://tu-frontend.vercel.app

# Debe apuntar al host donde vive ESTA API, no a otro despliegue.
# Render:     https://buildingfex-api.onrender.com/api/v1/payments/webhook
# Railway:    https://<tu-servicio>.up.railway.app/api/v1/payments/webhook
MercadoPago__NotificationUrl=https://TU-API/api/v1/payments/webhook

# --- CORS ---
# Origenes permitidos, separados por coma. Sin esto, cualquier origen es aceptado.
Cors__AllowedOrigins=https://tu-frontend.vercel.app
