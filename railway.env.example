# Copia estas variables en Railway → tu servicio API → Variables → Raw Editor

# NUNCA subas el AccessToken ni el WebhookSecret reales a git.
# Regeneralos en el panel de MercadoPago y pegalos solo en Railway → Variables.
MercadoPago__AccessToken=APP_USR-pega-aqui-tu-access-token
MercadoPago__PublicKey=APP_USR-pega-aqui-tu-public-key
MercadoPago__WebhookSecret=pega-aqui-tu-webhook-secret
MercadoPago__FrontendBaseUrl=https://TU-FRONTEND.vercel.app
MercadoPago__NotificationUrl=https://backend-production-5e544.up.railway.app/api/v1/payments/webhook

